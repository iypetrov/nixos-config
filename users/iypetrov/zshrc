# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# vi keybindings.
bindkey -v
export EDITOR='vim'
export KEYTIMEOUT=1
export LANG=en_US.UTF-8

# Base directory for project checkouts.
export XDG_PROJECTS_DIR="$HOME/projects"

# Private secrets synced by nixos-config-private's `make vm/secrets`.
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/secrets.env" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/secrets.env"

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history      # Append to history file.
setopt hist_ignore_space   # Don't store commands starting with space.
setopt hist_reduce_blanks  # Remove superfluous blanks.
setopt auto_cd             # If command is dir, cd into it.
setopt interactivecomments # Allow comments in command line.
setopt prompt_subst        # Enable prompt themes.

# Completion tweaks (compinit itself is run by home-manager's enableCompletion).
zstyle ':completion:*' menu select
zmodload zsh/complist
_comp_options+=(globdots)  # Include hidden files.

# Common
PROMPT='%n@%m %1~ %# '
alias ll='ls -la --color'
alias grep="grep --color"
alias ag="ag --hidden"
alias pbcopy="xclip -selection clipboard"
alias pbpaste="xclip -selection clipboard -o"

# Terraform
alias tf="terraform"
alias tfv="terraform validate"
alias tffmt="terraform fmt"
alias tfi="terraform init"

# Docker
alias d="podman"
alias docker="podman"
alias dcu="docker-compose up -d"
drm() {
  podman stop $( podman ps -aq )
  podman rm -f $( podman ps -aq )
}

# Kubernetes
export KUBE_EDITOR=vim
alias k="kubectl"

autoload -Uz add-zsh-hook

function _knav_sync_kubeconfig() {
  local state_file="${XDG_STATE_HOME}/knav/current"
  [[ ! -f "${state_file}" ]] && return

  local new_config
  new_config="$(sed "s|^~|${HOME}|" "${state_file}")"
  [[ ! -f "${new_config}" ]] && return

  if [[ "${KUBECONFIG}" != "${new_config}" ]]; then
    export KUBECONFIG="${new_config}"
    p10k reload 2>/dev/null || true
  fi
}

add-zsh-hook precmd _knav_sync_kubeconfig

function kube_navigator() {
  source kube_navigator.sh "$@"
  local _post_file="${XDG_STATE_HOME}/knav/post"
  if [[ -s "${_post_file}" ]]; then
    source "${_post_file}"
    : > "${_post_file}"
  fi
}

# Go
export GOBIN=$HOME/go/bin
export PATH=$PATH:$GOBIN

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
