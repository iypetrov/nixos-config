# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# vi keybindings.
bindkey -v
export EDITOR='vim'
export KEYTIMEOUT=1
export LANG=en_US.UTF-8

# History.
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history      # Append to history file
setopt hist_ignore_space   # Don't store commands starting with space
setopt hist_reduce_blanks  # Remove superfluous blanks
setopt auto_cd             # If command is dir, cd into it
setopt interactivecomments # Allow comments in command line
setopt prompt_subst        # Enable prompt themes

# Completion tweaks (compinit itself is run by home-manager's enableCompletion).
zstyle ':completion:*' menu select
zmodload zsh/complist
_comp_options+=(globdots)  # Include hidden files.

# --------------------------------------------------------------------------
# Aliases
# --------------------------------------------------------------------------

# common
alias ll='ls -la --color'
alias grep="grep --color"
alias logs="tail -f /var/log/syslog"

# bat
export BAT_THEME="Nord"

# `ag` is the silver searcher (silver-searcher-ng). `aggo` restricts it to Go
# files and skips generated code.
function aggo() {
    ag --go \
       --ignore 'zz_*.go' \
       --ignore '*_generated.go' \
       --ignore 'generated.pb.go' \
       "$@"
}

# terraform
alias tf="terraform"
alias tfv="terraform validate"
alias tffmt="terraform fmt"
alias tfi="terraform init"

# docker
alias d="docker"
alias dcu="docker-compose up -d"
drm() {
  docker stop $(docker ps -aq)
  docker rm -f $(docker ps -aq)
}

# kubectl
export KUBE_EDITOR=vim

# go
export GOBIN=$HOME/go/bin
export PATH=$PATH:$GOBIN

# --------------------------------------------------------------------------
# Functions
# --------------------------------------------------------------------------

kill_pids_on_port() {
    port=$1
    while read pid; do
        kill -9 ${pid}
    done < <(lsof -i :${port} | tail -n +2 | tr -s "[:space:]" " " | cut -d ' ' -f 2)
}

# --------------------------------------------------------------------------
# Completions (guarded so a missing tool doesn't error out the shell)
# --------------------------------------------------------------------------

command -v kubectl >/dev/null && source <(command kubectl completion zsh)

# --------------------------------------------------------------------------
# Prompt
# --------------------------------------------------------------------------

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
